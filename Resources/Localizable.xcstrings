    "Touch and hold your Home Screen, choose Edit, then Add Widget, and search for Candy Match. Add the progress ring from your Lock Screen's widget picker.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold your Home Screen, choose Edit, then Add Widget, and search for Candy Match. Add the progress ring from your Lock Screen's widget picker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den Home-Bildschirm gedrückt, wähle Bearbeiten, dann Widget hinzufügen und suche Candy Match. Den Fortschrittsring findest du in der Widget-Auswahl des Sperrbildschirms."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le doigt sur l’écran d’accueil, choisissez Modifier, puis Ajouter un widget, et cherchez Candy Match. Ajoutez l’anneau depuis le sélecteur de widgets de l’écran verrouillé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a Tela de Início pressionada, escolha Editar, depois Adicionar Widget e busque Candy Match. Adicione o anel pelo seletor de widgets da Tela Bloqueada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على الشاشة الرئيسية، واختر تعديل ثم إضافة أداة، وابحث عن Candy Match. يمكنك إضافة حلقة التقدم من معرض أدوات شاشة القفل."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按主畫面，選擇「編輯」再點選「加入小工具」，然後搜尋 Candy Match。也能從鎖定畫面的小工具選擇器加入進度圓環。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold your Home Screen, choose Edit, then Add Widget, and search for Candy Match. Add the progress ring from your Lock Screen's widget picker."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold your Home Screen, choose Edit, then Add Widget, and search for Candy Match. Add the progress ring from your Lock Screen's widget picker."
          }
        }
      }
    },
    "These previews show your saved progress. Widgets update when you play and at the start of a new UTC day.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
