    "The daily seed and refill sequence are the same for everyone. Complete today's puzzle to grow your daily streak. You can replay without losing your best result.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The daily seed and refill sequence are the same for everyone. Complete today's puzzle to grow your daily streak. You can replay without losing your best result."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tagesfeld und die Nachfüllfolge sind für alle gleich. Löse das heutige Rätsel für deine Serie. Beim Wiederholen bleibt dein bestes Ergebnis erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plateau et les remplissages du jour sont identiques pour tous. Terminez le défi pour prolonger votre série. Vous pouvez rejouer sans perdre votre meilleur résultat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tabuleiro e a sequência de reposição diários são iguais para todos. Conclua o desafio de hoje para aumentar sua sequência. Você pode jogar de novo sem perder seu melhor resultado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ لوحة اليوم بتوزيع واحد للجميع وتُملأ بالتسلسل نفسه. أكمل تحدي اليوم لتمدد سلسلتك. يمكنك تكراره مع الاحتفاظ بأفضل نتيجة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大家的每日開局和補充糖果順序都一樣。完成今天的謎題即可延續紀錄，重玩也會保留最佳成績。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The daily seed and refill sequence are the same for everyone. Complete today's puzzle to grow your daily streak. You can replay without losing your best result."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The daily seed and refill sequence are the same for everyone. Complete today's puzzle to grow your daily streak. You can replay without losing your best result."
          }
        }
      }
    },
