    "Four in a line creates a striped sweet that clears a row. Five creates a burst sweet that clears nearby tiles. Match it again to activate it, or swap two special sweets together.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four in a line creates a striped sweet that clears a row. Five creates a burst sweet that clears nearby tiles. Match it again to activate it, or swap two special sweets together."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier in einer Reihe erzeugen eine gestreifte Süßigkeit, die eine Reihe entfernt. Fünf erzeugen eine Explosionssüßigkeit, die Nachbarfelder entfernt. Verbinde sie erneut oder tausche zwei besondere Süßigkeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre douceurs alignées créent une douceur rayée qui efface une rangée. Cinq créent une douceur éclat qui efface les cases voisines. Alignez-la à nouveau ou échangez deux douceurs spéciales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro em linha criam um doce listrado que limpa uma fileira. Cinco criam um doce explosivo que limpa casas próximas. Combine-o de novo ou troque dois doces especiais."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أربع قطع متطابقة تُنتج حلوى مخططة تزيل صفًا، وخمس تُنتج حلوى تنفجر حولها. طابق القطعة المميزة مجددًا أو بدّل بين قطعتين مميزتين لتفعيلهما."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "四顆連線會製造可清除整列的條紋糖。五顆連線會製造可清除周遭糖果的爆裂糖。再次配對特殊糖或互換兩顆特殊糖即可啟動。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Four in a line creates a striped sweet that clears a row. Five creates a burst sweet that clears nearby tiles. Match it again to activate it, or swap two special sweets together."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Four in a line creates a striped sweet that clears a row. Five creates a burst sweet that clears nearby tiles. Match it again to activate it, or swap two special sweets together."
          }
        }
      }
    },
