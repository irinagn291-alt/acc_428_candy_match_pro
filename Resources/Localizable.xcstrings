    "Your progress stays on this device. Export a file to share results or import an earlier copy. Unfinished boards stay on the device where you started them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your progress stays on this device. Export a file to share results or import an earlier copy. Unfinished boards stay on the device where you started them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fortschritt bleibt auf diesem Gerät. Exportiere eine Datei, um Ergebnisse zu teilen, oder importiere eine ältere Kopie. Unfertige Spielfelder bleiben auf dem ursprünglichen Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre progression reste sur cet appareil. Exportez un fichier pour partager vos résultats ou importez une copie antérieure. Les parties en cours restent sur leur appareil d’origine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu progresso fica neste aparelho. Exporte um arquivo para compartilhar resultados ou importe uma cópia anterior. Os tabuleiros inacabados ficam no aparelho em que você começou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ سجلاتك على جهازك. يمكنك تصدير النتائج ومشاركتها أو استيراد نسخة سابقة. تبقى الألغاز غير المكتملة على الجهاز الذي بدأتها عليه."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進度會儲存在此裝置。可匯出檔案來分享紀錄，也能匯入先前的副本。尚未完成的棋盤會保留在原裝置上。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your progress stays on this device. Export a file to share results or import an earlier copy. Unfinished boards stay on the device where you started them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your progress stays on this device. Export a file to share results or import an earlier copy. Unfinished boards stay on the device where you started them."
          }
        }
      }
    },
