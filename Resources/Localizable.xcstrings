    "Tap two neighboring sweets, or swipe. A move counts only if it makes a line of three or more. Invalid moves cost nothing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap two neighboring sweets, or swipe. A move counts only if it makes a line of three or more. Invalid moves cost nothing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf zwei benachbarte Süßigkeiten oder wische. Ein Zug zählt nur bei einer Reihe aus mindestens drei gleichen Süßigkeiten. Ungültige Züge kosten nichts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez deux douceurs voisines ou faites glisser. Un coup compte seulement s’il forme une ligne d’au moins trois. Les coups invalides ne coûtent rien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em dois doces vizinhos ou deslize. Uma jogada só conta se formar uma linha de três ou mais. Jogadas inválidas não custam nada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على قطعتين متجاورتين أو اسحب للتبديل. تُحتسب الحركة إذا كوّنت صفًا من ثلاث قطع متشابهة على الأقل. لا تُخصم الحركات غير الصالحة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選相鄰的兩顆糖果或滑動交換。排成三顆以上相同糖果才會扣除一步，無效的移動不扣步數。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap two neighboring sweets, or swipe. A move counts only if it makes a line of three or more. Invalid moves cost nothing."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap two neighbouring sweets, or swipe. A move counts only if it makes a line of three or more. Invalid moves cost nothing."
          }
        }
      }
    },
