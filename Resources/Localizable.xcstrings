    "Daily challenges reset at midnight UTC. Reminders follow your device's local time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily challenges reset at midnight UTC. Reminders follow your device's local time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagesaufgaben wechseln um Mitternacht UTC. Erinnerungen richten sich nach der Ortszeit deines Geräts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les défis changent à minuit UTC. Les rappels suivent l’heure locale de votre appareil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os desafios mudam à meia-noite UTC. Os lembretes seguem o horário local do aparelho."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتغير التحدي اليومي عند منتصف الليل بالتوقيت العالمي. تعمل التذكيرات بتوقيت جهازك المحلي."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每日挑戰在世界協調時間零時更新，提醒則依裝置的當地時間傳送。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily challenges reset at midnight UTC. Reminders follow your device's local time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
