    "Choose a gentle morning invitation and an evening nudge. Notifications are scheduled on this device; permission is optional.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a gentle morning invitation and an evening nudge. Notifications are scheduled on this device; permission is optional."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kleine Einladung am Morgen und eine Erinnerung am Abend. Mitteilungen werden auf diesem Gerät geplant; die Erlaubnis ist freiwillig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une invitation le matin et un petit rappel le soir. Les notifications sont programmées sur cet appareil ; l’autorisation est facultative."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um convite pela manhã e um lembrete à noite. As notificações são agendadas neste aparelho; a permissão é opcional."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر تذكيرًا صباحيًا وآخر مسائيًا. تُجدول الإشعارات على جهازك بعد موافقتك."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選擇接收早晨和晚間提醒。通知會在授權後於本機排程。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a gentle morning invitation and an evening nudge. Notifications are scheduled on this device; permission is optional."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a gentle morning invitation and an evening nudge. Notifications are scheduled on this device; permission is optional."
          }
        }
      }
    },
