    "Fill the score goal and collect the pink hearts shown at the top. One, two or three stars depend on the moves you have left.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill the score goal and collect the pink hearts shown at the top. One, two or three stars depend on the moves you have left."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreiche die Zielpunktzahl und sammle die rosa Herzen oben. Je nach übrigen Zügen erhältst du einen, zwei oder drei Sterne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atteignez le score et collectez les cœurs roses indiqués en haut. Le nombre de coups restants détermine vos une, deux ou trois étoiles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcance a pontuação e colete os corações rosa indicados no topo. Você ganha uma, duas ou três estrelas conforme as jogadas restantes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغ هدف النقاط واجمع القلوب الوردية الظاهرة في الأعلى. تحصل على نجمة أو اثنتين أو ثلاث بحسب الحركات المتبقية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "達到指定分數並收集畫面上方所示的粉紅愛心。剩餘步數決定能獲得一至三顆星。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill the score goal and collect the pink hearts shown at the top. One, two or three stars depend on the moves you have left."
          }
